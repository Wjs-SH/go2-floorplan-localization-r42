# E5-RT candidate additions (on top of a field profile). Defaults below are the candidate's code defaults made explicit.
KCI_LIVE_BOXES=tracked           # live image: LK-verified boxes on that frame only (legacy = student 2.5 s old boxes)
SCI_CTX_MIN=0.078                # lazy context crops (decision-exact for legacy logic; measured 0 board-gate flips / 30 scenes)
SCI_E5RT_VISION_ONLY=1           # drop text tower after caching (GPU reserved -650 MB; host MemAvailable gain ~50-120 MB)
SCI_E5RT_GPU_PREP=1              # normalise crops on GPU (bit-identical inputs)
SCI_E5RT_SIGLIP_CACHE=off        # B3 per-track cache: opt-in (see E5RT_ABLATION_RESULTS.csv)
SCI_E5RT_HOME_WITHOUT_ARM=0      # E5RT2: no unarmed cleanup grant; supervised event-scoped policy required
