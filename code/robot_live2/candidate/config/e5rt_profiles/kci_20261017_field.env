# E5-RT profile: reproduce the 10-17 field configuration (B0 environment) EXPLICITLY. Every line is an EXPERIMENT OVERRIDE
# of a SCI/R1 value that has NOT been validated as the final policy (see E5RT_CHANGE_DISPOSITION.csv).
SCI_P2_REACTION_S=2.5            # student 10-16 (10-15 n=9 operator sample); SCI 1.5 = assumption too
SCI_P2_OBLIQUITY_MAX_DEG=75      # student 10-17 ③; SCI 55. OCR readability at 70-75 deg NOT measured
SCI_P2_RANGE_MAX_M=5.0           # student 10-17 ③; SCI 4.0
SCI_ODOM_SPEED_WIN_S=1.0         # student 10-16 LSQ speed window (kept student fix; thresholds unchanged)
SCI_QUALITY_SHARP_MIN=20         # student 10-17 ⑤ full-image Laplacian; R1 40. NOT comparable with console centre metric 30
SCI_AIM_TIMEOUT_S=70             # kci_field_up.sh value
SCI_E5_CPUS=0,1                  # kci_field_up.sh value (cores 2-5 made scenes 1.5-5 s on 10-17; not a universal rule)
